function enqueueInit() {
    global requests: list[{id: num, method: str, endpoint: str, body: dict}] = [];
    start handleWebQueue(targetMode = "With no targets");
}

function enqueueRequestBlocking(
    method: str,
    path: str,
    body: dict
): any {
    global requests: list[{id: num, method: str, endpoint: str, body: str}];

    global enqueueIdTracker: num;
    enqueueIdTracker += 1;

    line id = enqueueIdTracker;
    requests.append({
        id: id,
        method: method,
        endpoint: path,
        body: var.toJSON(body)
    });

    global "enqueue.%var(id)": dict;
    while(!(var.exists(global "enqueue.%var(id)"))) {
        wait(1);
    }
    line tmp = global "enqueue.%var(id)";
    var.purgeMatching("enqueue.%var(id)", matchRequirement = "Entire name");
    return tmp;
}



function enqueueRequestAndForget(
    method: str,
    path: str,
    body: dict
) {
    global requests: list[{id: num, method: str, endpoint: str, body: str}];

    requests.append({
        id: -1,
        method: method,
        endpoint: path,
        body: var.toJSON(body)
    });
}

process handleWebQueue {
    global requests: list[{id: num, method: str, endpoint: str, body: str}];
    repeat {
        line queueData: list[{id: num, method: str, endpoint: str, body: str}] = [];
        line queueDataStr: str = "[]";

        repeat {
            if(requests.len() == 0) {
                break;
            }

            queueDataStr = var.toJSON(queueData);
            line next = requests.pop();

            line estLen = (queueDataStr + var.toJSON(next)).len();
            if(estLen >= 9500) {
                requests.append(next);
                break;
            }

            queueData.append(next);
        }

        queueDataStr = var.toJSON(queueData);

        if(queueData.len() != 0) {
            line rawResp = var.getWebResponse(
                webUrl + ":" + port + "/v1/enqueue",
                queueDataStr,
                method = "Post",
                contentType = "application/json"
            );
            line respJson = rawResp["json"] as list[{id: num, body: str}];

            for (line entry of respJson) {
                global "enqueue.%entry(entry,id)" = var.fromJSON(entry["body"]);
            }
        } else {
            wait(1);
        }
    }
}