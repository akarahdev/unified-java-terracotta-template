gameevent startup {
    declare global port: num = 8080;
    declare global webUrl: str = "URL HERE";

    enqueue_init();
}

playerevent sneak {
    line resp = var.getWebResponse(
        webUrl + ":" + port + "/v1/hello",
        "",
        method = "Get"
    );
    print(resp);
    wait(5);

    for(line idx of range(1, 1000)) {
        enqueue_request_and_forget("GET", "/v1/hello", {});
    }

    for(line idx of range(1, 10)) {
        start testsend();
    }
}

process testsend {
    line data = enqueue_request_blocking("GET", "/v1/hello", {});
    print(data);
}